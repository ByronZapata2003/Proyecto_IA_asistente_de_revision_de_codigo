# OpenAI API (no agregue comillas ni comparta este archivo con secretos)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Persistencia local
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=web_screenshot_builder

# API consumida por Streamlit y el notebook
API_URL=http://127.0.0.1:8000
MAX_IMAGE_MB=10
URL_CAPTURE_TIMEOUT_SECONDS=25
