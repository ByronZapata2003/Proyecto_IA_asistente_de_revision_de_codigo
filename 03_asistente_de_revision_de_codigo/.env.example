# Proveedor de visión: gemini u openai
AI_PROVIDER=gemini

# Gemini API: clave creada en Google AI Studio (nivel gratuito sujeto a elegibilidad/cuotas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Alternativa OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Persistencia local
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=web_screenshot_builder

# API consumida por Streamlit y el notebook
API_URL=http://127.0.0.1:8000
MAX_IMAGE_MB=10
URL_CAPTURE_TIMEOUT_SECONDS=25
