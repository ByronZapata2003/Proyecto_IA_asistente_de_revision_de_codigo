# OpenAI API (no agregue comillas ni comparta este archivo con secretos)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: proveedor Gemini (usa AI_PROVIDER=gemini para activarlo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# MongoDB Atlas: pega la cadena de conexión del cluster y reemplaza sus credenciales.
# Ejemplo: mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Si prefieres MongoDB local, usa mongodb://127.0.0.1:27017
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=web_screenshot_builder

# API consumida por Streamlit y el notebook
API_URL=http://127.0.0.1:8000
MAX_IMAGE_MB=10
URL_CAPTURE_TIMEOUT_SECONDS=25
